# Application
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
DATABASE_PATH=./data/plumbline.sqlite3

# Groq (keep this key on the backend; never use a VITE_ variable for secrets)
GROQ_API_KEY=your_real_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Ambiguous rule alerts: a rule is flagged after this many disputes,
# or when this share of its flags is disputed (needs at least AMBIGUITY_MIN_FLAGS flags)
AMBIGUITY_MIN_DISPUTES=3
AMBIGUITY_MIN_FLAGS=3
AMBIGUITY_DISPUTE_RATE=0.4

# Grounded RAG audit (Improvement 1)
# Optional: free Gemini key from https://aistudio.google.com/apikey adds vector search (gemini-embedding-001).
# Without it, retrieval uses BM25 keyword search only and everything still works.
GEMINI_API_KEY=
# Optional: Postgres (e.g. Supabase) URL for rulebook storage with pgvector. Leave empty to use the local SQLite file.
# Needs: pip install "psycopg[binary]"
RAG_DATABASE_URL=

# LinkedIn Developer App -> Auth tab -> Client ID/Secret + Authorized redirect URL
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/social/callback/linkedin
LINKEDIN_API_VERSION=202610

# Meta Developer App (Facebook Login product). Redirect URL must be configured exactly.
# Used to connect Facebook Pages and eligible linked Instagram Professional accounts.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:8000/api/social/callback/meta
META_GRAPH_VERSION=v27.0

# Threads API app/use case and redirect URL
THREADS_APP_ID=
THREADS_APP_SECRET=
THREADS_REDIRECT_URI=http://localhost:8000/api/social/callback/threads

# X Developer App -> User authentication settings (OAuth 2.0)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/social/callback/x

# Google Cloud OAuth Client (YouTube Data API v3 enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/social/callback/youtube
